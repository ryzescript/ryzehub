local _b = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
local function _d(data)
	data = data:gsub("[^" .. _b .. "=]", "")
	local t = {}
	local n = 1
	local buf, bits = 0, 0
	for i = 1, #data do
		local c = data:sub(i, i)
		if c ~= "=" then
			local v = _b:find(c, 1, true) - 1
			buf = buf * 64 + v
			bits = bits + 6
			if bits >= 8 then
				bits = bits - 8
				t[n] = string.char(math.floor(buf / 2 ^ bits) % 256)
				n = n + 1
				buf = buf % 2 ^ bits
			end
		end
	end
	return table.concat(t)
end

